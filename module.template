#%Module1.0#####################################################################
##
## Parasites and Microbes strain-mapper {{version}}
##

# help setup
proc ModulesHelp { } {
  global version modroot

  puts stderr "Custom deployment managed by pathogen informatics: {{path}}"
  puts stderr "Executables:"
  puts stderr "\tstrain-mapper"
  puts stderr "Home page: {{repo_url}}"
}

# Whatis setup
module-whatis "Custom deployment managed by pathogen informatics: {{path}}"
module-whatis "Executables:"
module-whatis "strain-mapper"

# Load prerequisite modules
module load nextflow
module load ISG/singularity

# Load message
if { [ module-info mode load ] } {
    puts stderr "\tModule loaded. For more information run 'module help {{farm_name}}/{{version}}' or check the README at {{repo_url}}/-/blob/{{version}}/README.md?ref_type=tags."}

# Conflicts
conflict strain-mapper

# Add wrappers to PATH
prepend-path PATH "{{path}}/strain-mapper"
prepend-path PATH "{{path}}/strain-mapper/scripts"
