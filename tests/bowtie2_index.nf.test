nextflow_process {

    name "Test Process BOWTIE2_INDEX"
    script "modules/bowtie2.nf"
    process "BOWTIE2_INDEX"

    test("Should run without failures") {

        when {
            params {
                max_cpus   = "1"
                max_memory = "2.GB"
                max_time   = "1.h"
                outdir = "${outputDir}"
            }
            process {
                """
                input[0] = [file("test_data/inputs/ref/GCF_000011265.1.fna")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.bt2_index).match()
        }

    }

}
