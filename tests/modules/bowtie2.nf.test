nextflow_process {

    name "Test Process BOWTIE2"
    script "modules/bowtie2.nf"
    process "BOWTIE2"

    test("Should run without failures") {

        when {
            params {
                max_cpus   = "1"
                max_memory = "2.GB"
                max_time   = "1.h"
                outdir = "${outputDir}"
            }
            process {
                """
                input[0] = [["id": "12483_8#10"], [file("test_data/inputs/reads/12483_8#10_1.fastq.gz"), file("test_data/inputs/reads/12483_8#10_2.fastq.gz")]]
                input[1] = [file("test_data/inputs/bowtie2_indexing/GCF_000011265.1.1.bt2"), file("test_data/inputs/bowtie2_indexing/GCF_000011265.1.2.bt2"), file("test_data/inputs/bowtie2_indexing/GCF_000011265.1.3.bt2"), file("test_data/inputs/bowtie2_indexing/GCF_000011265.1.4.bt2"), file("test_data/inputs/bowtie2_indexing/GCF_000011265.1.rev.1.bt2"), file("test_data/inputs/bowtie2_indexing/GCF_000011265.1.rev.2.bt2")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.mapped_reads).match()
        }

    }

}
