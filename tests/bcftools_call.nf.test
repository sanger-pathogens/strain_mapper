nextflow_process {

    name "Test Process BCFTOOLS_CALL"
    script "modules/bcftools.nf"
    process "BCFTOOLS_CALL"

    test("Should run without failures") {

        when {
            params {
                max_cpus   = "1"
                max_memory = "2.GB"
                max_time   = "1.h"
                outdir = "${outputDir}"
            }
            process {
                """
                input[0] = [["id": "12483_8#10"], file("test_data/inputs/bcftools_mpileup/12483_8#10.mpileup")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.curated).match()
        }

    }

}
